# Telegram (obrigatório p/ o bot; API funciona sem)
TELEGRAM_TOKEN=
# SerpAPI (opcional; sem ela, só índice local)
# engine: google (orgânico, padrão) ou google_news (legado)
# estrategia: agente (padrão), simples, avancada ou ambas
# Legado news-only: SERP_ENGINE=google_news + SERP_ESTRATEGIA=simples
# (estrategia=agente orquestra os motores e ignora SERP_ENGINE).
SERPAPI_KEY=
SERP_ENGINE=google
# estrategia (orgânico): agente (padrão), simples, avancada ou ambas
SERP_ESTRATEGIA=agente
# teto global de buscas do agente por /checar
AGENTE_MAX_BUSCAS=8
# hosts extras de checagem além dos 13 do padrão (vírgula)
SERP_SITES_EXTRAS=
# LLM local OpenAI-compatível (Unsloth/vLLM; só p/ afirmações e padrões)
UNSLOTH_BASE_URL=http://127.0.0.1:8888/v1
UNSLOTH_MODEL_NAME=
# Unsloth Studio com login: crie uma API key no Studio (sk-unsloth-...); sem login, deixe not-needed
UNSLOTH_API_KEY=not-needed
# laya (classificação e implicação; default já calibrado)
LAYA_THRESHOLD=0.80
LAYA_MODEL=auto
# Pipeline
RELEVANCIA_MIN=0.30
MAX_AFIRMACOES=3
MAX_EVIDENCIAS=5
CACHE_SERPAPI_TTL=3600
# Cache de relatórios completos (0 = desliga)
RESULT_CACHE_TTL=1800
# Modelo próprio fake-news (vazio = mock explícito).
# BERTimbau v6 R0: pasta com model.safetensors + calibration.json
# (Release modelo-v6-R0 do FakenewsBR; requer torch + transformers).
FAKE_MODEL_PATH=
# Em texto curto o modelo erra por formato (teste v6: <80 palavras acerta 65-74% das
# verdadeiras; >=80 acerta 89-95%). Abaixo disso ele não opina.
FAKE_MODEL_MIN_PALAVRAS=80
# Peso do modelo no agregador (sinal auxiliar, não o principal)
FAKE_MODEL_CONFIANCA=0.5
# Feedback 👍/👎 (vazio = feedback.jsonl na raiz do projeto)
FEEDBACK_PATH=

# Auditoria de 13/10/2026
# Grava prompt e resposta do LLM por inteiro no trace (runs/). Padrão desligado. Ver docs/TELEMETRIA.md.
# TELEMETRIA_PROMPTS=1
# Langfuse (opcional): espelha os runs; ver docs/TELEMETRIA.md §1.x
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_AUTO=0
# Espaçamento das chamadas ao OpenRouter (req/min). Padrão 3 (modelos gratuitos); com modelo pago use 30-60.
# OPENROUTER_RPM=30
# Limita o raciocínio do modelo (low|medium|high|none). Sem isso, modelos de raciocínio gastam os max_tokens.
# OPENROUTER_REASONING_EFFORT=none
# Padrões de linguagem via LLM (sinal de estilo, fora do nível). Padrão desligado.
# PADROES_LLM=1

# Auditoria E (A1): liga os campos eval_* do POST /checar (fonte deixada de fora, repetição sem cache do juiz).
# Só para subir a API de uma simulação de avaliação; nunca em produção.
# EVAL_MODO=1
# Missão F / A4: seleção do trecho do juiz. novo (padrão) = título + lide + parágrafo de conclusão/veredito +
# frases relevantes, sem rodapé/boilerplate, dentro de JUIZ_TRECHO_MAX; antigo = seleção anterior (medição).
JUIZ_TRECHO_MODO=novo
# Missão F / A2: sintetizador por afirmação (1 = liga). Relê o conjunto de itens julgados e só pode
# rebaixar o nível (alta/baixa -> media/indeterminada); nunca sobe nem inverte. Custa 1 chamada LLM por afirmação.
SINTETIZADOR=0
SINTETIZADOR_MAX_ITENS=12
SINTETIZADOR_MAX_TOKENS=1200
SINTETIZADOR_TIMEOUT_S=90

# Missão F / A5: planejador de busca (padrão desligado). Ligado: relaxa consulta vazia (sem site:/aspas, menos
# termos), manda consultas com site: ao Google orgânico (a pura segue em SERP_ENGINE), lê mais resultados quando
# os primeiros são fora do tema e usa o orçamento que sobra (até BUSCA_EXTRAS_MAX ondas extras). Respeita
# AGENTE_MAX_BUSCAS, --max-buscas e SERPAPI_ORCAMENTO_RESTANTE.
# BUSCA_PLANEJADOR=1
# BUSCA_RELAXAR_RODADAS=2
# BUSCA_LER_MAX=16
# BUSCA_FORA_TEMA_FRACAO=0.5
# BUSCA_EXTRAS_MAX=3
# Missão F / A6: trava de similaridade no atalho do índice (padrão 0 = desligada).
# 1 = quando UM só cluster decide pelo selo do índice e a alegação da checagem não se parece com o núcleo
# da afirmação (Dice < INDICE_TRAVA_SIM_MIN), o nível tem teto "media" (evento "trava" no trace).
INDICE_TRAVA_SIMILARIDADE=0
# Similaridade mínima (0..1). 0,6 = o `cobertura_min` do próprio índice (mesma razão: 3 de cada 5 termos).
INDICE_TRAVA_SIM_MIN=0.6
# Missão F / item 7 (Extrator): 1 = limpeza determinística do núcleo e da consulta (sem marcadores
# temporais, moldura de entrega nem palavras-ruído); os marcadores vão para `marcadores_tempo` (E4 os lê).
EXTRATOR_LIMPEZA=0
# Missão F / A3: autoconsistência do juiz (1=liga). Só age quando um único julgamento SUSTENTA/REFUTA decide
# o nível: rejulga o item K-1 vezes (temperatura > 0, sem cache) e vale a maioria; divergência de direção
# vira RELATA_SEM_ENDOSSO. Em IO_MODO=record/replay as repetições têm cassete próprio (grave com record).
JUIZ_AUTOCONSISTENCIA=0
JUIZ_AUTOCONSISTENCIA_K=3
JUIZ_AUTOCONSISTENCIA_TEMP=0.5
