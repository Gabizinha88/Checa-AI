# CrossCheckBR: copie para .env e preencha. Nunca versione o .env (tem chaves).
# Linhas com "# VAR=valor" mostram o padrão; descomente só para mudar.
# tests/test_env_exemplo.py garante que toda variável lida pelo código está aqui.

# ---------------------------------------------------------------- chaves
# Telegram (obrigatório p/ o bot; a API funciona sem)
TELEGRAM_TOKEN=
# SerpAPI (opcional; sem ela, só a base de checagens local). Cada busca gasta cota da conta.
SERPAPI_KEY=
# OpenRouter: LLM das afirmações, do juiz e da reformulação. Sem ela, cai no LLM local e,
# sem LLM nenhum, em regras léxicas (resultado tende a "indeterminada").
# O /saude mostra se a chave vale, quando expira e o saldo.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------- OpenRouter
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free
# modelo só do juiz (vazio = o mesmo dos demais passos)
# OPENROUTER_MODEL_JUIZ=
# provedor preferido do modelo (vazio = o OpenRouter escolhe)
# OPENROUTER_PROVIDER_ORDER=StreamLake
# OPENROUTER_TIMEOUT_S=30
# OPENROUTER_MAX_TOKENS=600
# none|low|medium|high. "none" evita resposta vazia: o raciocínio gasta os max_tokens
OPENROUTER_REASONING_EFFORT=none
# chamadas por minuto (0 = sem limite). Modelos :free aguentam ~3; pagos, 30 ou mais
OPENROUTER_RPM=30
# API de decisões (Jev) na descoberta de sites: 1 liga
# JEV_ATIVO=0
# JEV_TIMEOUT_S=12

# ---------------------------------------------------------------- LLM local (fallback)
# Servidor OpenAI-compatível (Unsloth Studio, vLLM, llama.cpp)
UNSLOTH_BASE_URL=http://127.0.0.1:8888/v1
# vazio = o modelo carregado no servidor (loaded: true em /models)
UNSLOTH_MODEL_NAME=
# Unsloth Studio com login: crie uma API key no Studio (sk-unsloth-...); sem login, deixe not-needed
UNSLOTH_API_KEY=not-needed
# LLM_TIMEOUT_S=240
# 1 = deixa o modelo local "pensar" antes de responder (mais lento)
# LLM_LOCAL_RACIOCINIO=0

# ---------------------------------------------------------------- SerpAPI e agente de busca
# engine: google (orgânico, padrão) ou google_news (legado)
# estratégia: agente (padrão), simples, avancada ou ambas.
# Legado news-only: SERP_ENGINE=google_news + SERP_ESTRATEGIA=simples
# (estratégia agente orquestra os motores e ignora SERP_ENGINE).
SERP_ENGINE=google
SERP_ESTRATEGIA=agente
# teto de buscas por dia no projeto (o contador fica em eval/serpapi_uso.json)
SERPAPI_DAILY_CAP=100
# teto total de buscas live contadas no arquivo de uso (vazio = sem teto)
# SERPAPI_ORCAMENTO_RESTANTE=
# timeout por tentativa; timeout ou queda de conexão ganha 1 nova tentativa
# SERPAPI_TIMEOUT_S=15
# cache de resultados de busca (segundos)
# CACHE_SERPAPI_TTL=3600
# teto global de buscas do agente por /checar
AGENTE_MAX_BUSCAS=9
# AGENTE_MAX_ONDAS_EXTRAS=1
# AGENTE_TIMEOUT_S=60
# AGENTE_MAX_POR_AFIRMACAO=12
# consultas às agências na onda 1: "or" = uma consulta (site:a OR site:b …);
# "separado" = uma consulta site: por agência, nas N primeiras do catálogo (mais buscas)
# AGENTE_SITES_MODO=or
# AGENTE_SITES_SEPARADOS=3
# hosts extras de checagem além dos do padrão (vírgula)
SERP_SITES_EXTRAS=

# ---------------------------------------------------------------- base de checagens
# 1 = consulta a base local de checagens antes da web (padrão); 0 = só busca aberta (eval)
INDICE_CHECAGENS=1
# INDICE_SCORE_MIN=1.0
# 0 = não baixa recursos do NLTK na primeira execução
# FACTCHECK_NLTK_DOWNLOAD=1

# ---------------------------------------------------------------- leitura das páginas
# DEEP_CRAWL_MAX_PAGES=12
# DEEP_CRAWL_TOTAL=36
# DEEP_CRAWL_TIMEOUT_S=15
# DEEP_CRAWL_MAX_BYTES=5000000
# DISCOVERY_MAX_SITES=2
# DISCOVERY_TIMEOUT_S=8
# DISCOVERY_MAX_BYTES=5000000
# Fora do catálogo, "site muito acessado" = entre os N domínios mais acessados da lista Tranco
TRAFEGO_RANK_MAX=200000
# ReaderLM (extração por LLM em páginas difíceis): 1 liga
# EXTRACAO_READERLM=0
# READERLM_BASE_URL=http://127.0.0.1:8889/v1
# READERLM_MODEL=mradermacher/ReaderLM-v2-GGUF
# READERLM_API_KEY=not-needed
# READERLM_TIMEOUT_S=180
# READERLM_MAX_TOKENS=1024
# READERLM_MAX_CHARS=120000

# ---------------------------------------------------------------- juiz
# JUIZ_MAX_NOTICIAS=10
# JUIZ_LOTE=5
# JUIZ_TRECHO_MAX=2500
# JUIZ_MAX_TOKENS=4000
# fração mínima da citação do juiz que precisa estar no texto da página
# JUIZ_CITACAO_MIN=0.9
# JUIZ_TIMEOUT_TOTAL_S=600
# JUIZ_CONCORRENCIA=1

# ---------------------------------------------------------------- laya (classificação e implicação)
LAYA_THRESHOLD=0.80
LAYA_MODEL=auto
# vazio = cpu; cuda|mps só com teste local
# LAYA_DEVICE=

# ---------------------------------------------------------------- pipeline
RELEVANCIA_MIN=0.30
MAX_AFIRMACOES=3
MAX_EVIDENCIAS=5
# Cache de relatórios completos (segundos; 0 = desliga)
RESULT_CACHE_TTL=1800
# RESULT_CACHE_MAX=256
# API_RATE_LIMIT_PER_MIN=30
# Modelo próprio fake-news (vazio = mock explícito).
# BERTimbau v6 R0: pasta com model.safetensors + calibration.json
# (Release modelo-v6-R0 do FakenewsBR; requer torch + transformers).
FAKE_MODEL_PATH=
# Em texto curto o modelo erra por formato (teste v6: <80 palavras acerta 65-74% das
# verdadeiras; >=80 acerta 89-95%). Abaixo disso ele não opina.
FAKE_MODEL_MIN_PALAVRAS=80
# Peso do modelo no agregador (sinal auxiliar, não o principal)
FAKE_MODEL_CONFIANCA=0.5
# Feedback 👍/👎 (vazio = feedback.jsonl na raiz do projeto)
FEEDBACK_PATH=

# ---------------------------------------------------------------- telemetria, eval e replay
# 0 = não grava runs/<run_id>/trace.jsonl
# TELEMETRIA=1
# TELEMETRIA_DIR=runs
# live (padrão) | record | replay. O eval define sozinho; veja docs/TELEMETRIA.md
# IO_MODO=live
# CASSETES_DIR=eval/cassettes
# 1 = em record, só o LLM vai à rede; SerpAPI e páginas vêm dos cassetes
# LLM_ONLY_RECORD=0
# SERPAPI_USO_ARQ=eval/serpapi_uso.json
